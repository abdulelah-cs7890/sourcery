# ─────────────────────────────────────────────────────────────
# Neon Postgres (https://neon.tech)
# Project → Connection Details → "Pooled connection" recommended
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/sourcery?sslmode=require

# ─────────────────────────────────────────────────────────────
# Upstash Redis (https://console.upstash.com)
# Create a global Redis DB → Details tab → REST API section
# ─────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ─────────────────────────────────────────────────────────────
# Resend (https://resend.com)
# For magic-link emails. Verify a sending domain or use the
# resend.dev sandbox during local dev.
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_
AUTH_RESEND_FROM=Sourcery <onboarding@resend.dev>

# ─────────────────────────────────────────────────────────────
# Auth.js v5
# AUTH_SECRET: `pnpm dlx auth secret` to generate
# AUTH_URL: leave empty in production (Vercel infers), set locally
# ─────────────────────────────────────────────────────────────
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# CJ Dropshipping (https://developers.cjdropshipping.com)
# Register → Developer Center → API access → copy email + apiKey
# ─────────────────────────────────────────────────────────────
CJ_EMAIL=
CJ_API_KEY=
